# Copier vers .env et ajuster :
#   cp .env.example .env

DB_ENABLED=1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=user
DB_PASSWORD=pass
DB_NAME=db_objet

IOTHUB_DEVICE_CONNECTION_STRING=

DEVICE_ID=porte_serre_01
TELEMETRY_INTERVAL_SECONDS=60

# Cloud API (Cosmos DB)
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DB_NAME=db_objet_cloud
COSMOS_TELEMETRY_CONTAINER=telemetry
COSMOS_COMMAND_CONTAINER=commands

# Feedback de commandes cloud -> objet -> cloud
COMMAND_FEEDBACK_ENABLED=1
CLOUD_API_BASE_URL=
COMMAND_POLL_INTERVAL_SECONDS=3


